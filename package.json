{
  "name": "@chitrank2050/ask-widget",
  "description": "A lightweight chat widget for developer portfolios. Drop-in floating chat with SSE streaming, dark/light themes, and configurable positioning.",
  "private": false,
  "version": "0.6.1",
  "type": "module",
  "homepage": "https://github.com/chitranklabs/ask-widget#readme",
  "author": {
    "name": "Chitrank agnihotri",
    "email": "chitrank2050@gmail.com",
    "url": "https://wwww.chitrankagnihotri.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chitranklabs/ask-widget"
  },
  "bugs": {
    "url": "https://github.com/chitranklabs/ask-widget/issues"
  },
  "keywords": [
    "react",
    "chat",
    "widget",
    "rag",
    "portfolio",
    "sse",
    "streaming",
    "chatbot",
    "ai"
  ],
  "main": "./dist/ask-widget.cjs.js",
  "module": "./dist/ask-widget.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ask-widget.es.js",
      "require": "./dist/ask-widget.cjs.js"
    },
    "./styles.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "preview": "vite preview --outDir dist-app",
    "menu": "node scripts/menu.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy:docs": "./scripts/docs-deploy.sh",
    "init": "./scripts/install.sh",
    "obliviate": "node scripts/menu.mjs obliviate",
    "clean-setup": "pnpm run obliviate && pnpm run init",
    "clean-build": "pnpm run obliviate && pnpm run init && pnpm run build:lib",
    "git": "node scripts/menu.mjs git",
    "docs": "node scripts/menu.mjs docs",
    "prepare": "test -n \"$CI\" || lefthook install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts,.tsx --max-warnings 0",
    "lint:md": "markdownlint --fix \"**/*.md\" --ignore node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "deps:update": "pnpm update --interactive --latest"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@chitrank2050/git-hygiene": "^0.4.11",
    "@clack/prompts": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@joshwooding/vite-plugin-react-docgen-typescript": "^0.8.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vercel/analytics": "^2.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^30.0.0",
    "lefthook": "^2.1.6",
    "markdownlint-cli": "^0.49.1",
    "oxc-minify": "^0.148.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.2.5",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "git-hygiene": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "types": [
      "feat",
      "fix",
      "chore",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "revert",
      "maintenance",
      "renovate"
    ]
  }
}
